│   └── dataParsers/        # Device-specific parsers
│       ├── polar.ts
│       ├── garminFit.ts
│       ├── oxiwear.ts
│       └── utils.ts
├── types/                  # Type definitions
│   ├── config.ts
│   ├── dataparsers.ts
│   └── graph.ts
└── treads/                 # Multi-threading
    ├── primary.ts
    └── wokrerThread.ts
```

